# Optional: Crisp live-chat widget. Leave empty to disable.
PUBLIC_CRISP_ID=

# Optional overrides for the search-engine codes in src/site.ts (the "HTML tag" method).
# Google Search Console → Add property → URL prefix → HTML tag → copy the content="…" value.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag → copy the content="…" value.
PUBLIC_BING_SITE_VERIFICATION=
