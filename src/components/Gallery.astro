---
/** Horizontal, swipeable strip of slides with previous/next controls. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery-track" data-gallery-track tabindex="0" aria-label={`${alt} slides`} role="region">
    {
      images.map((src, i) => (
        <Image
          class="frame"
          src={src}
          alt={`${alt} — ${i + 1} of ${images.length}`}
          widths={[640, 960, 1440]}
          sizes="(min-width: 760px) 640px, 88vw"
        />
      ))
    }
  </div>
  <div class="gallery-controls" data-gallery-controls hidden>
    <span class="gallery-count" data-gallery-count aria-live="polite">1 / {images.length}</span>
    <div class="gallery-buttons">
      <button type="button" data-gallery-prev aria-label="Previous slide"><Icon name="chevron-left" size={18} /></button>
      <button type="button" data-gallery-next aria-label="Next slide"><Icon name="chevron-right" size={18} /></button>
    </div>
  </div>
</div>
