---
/** Floating iOS tab bar for small screens. */
import Icon from './Icon.astro';
import type { Current } from './Nav.astro';

interface Props {
  current: Current;
}

const { current } = Astro.props;

const tabs = [
  { key: 'home', href: '/', label: 'Home', icon: 'house' },
  { key: 'portfolio', href: '/portfolio', label: 'Portfolio', icon: 'briefcase' },
  { key: 'resume', href: '/resume', label: 'Resume', icon: 'file-text' },
];
---

<nav class="tabbar glass" aria-label="Pages">
  {
    tabs.map((tab) => (
      <a href={tab.href} class="tab" aria-current={tab.key === current ? 'page' : undefined}>
        <Icon name={tab.icon} size={22} />
        <span>{tab.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .tabbar {
    position: fixed;
    left: 50%;
    bottom: calc(14px + env(safe-area-inset-bottom));
    z-index: 60;
    display: none;
    grid-template-columns: repeat(3, 1fr);
    width: min(100% - 24px, 340px);
    padding: 5px;
    border-radius: 999px;
    transform: translateX(-50%);
    view-transition-name: tabbar;
  }

  @media (max-width: 899px) {
    .tabbar {
      display: grid;
    }
  }

  .tab {
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 7px 2px 6px;
    border-radius: 999px;
    color: var(--label-2);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
    transition:
      color 0.2s var(--ease),
      background-color 0.25s var(--ease);
  }

  .tab[aria-current='page'] {
    color: var(--accent);
    background: var(--fill);
  }
</style>
