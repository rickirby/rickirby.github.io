---
/**
 * One place for every icon on the site.
 * UI glyphs come from Lucide (SF Symbols-like line icons); brand marks are inlined.
 */
import {
  AlarmClock,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BatteryFull,
  BellRing,
  Blocks,
  BookOpen,
  Bot,
  Brain,
  Briefcase,
  Camera,
  Check,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  CircleCheck,
  CirclePlay,
  Copy,
  Cpu,
  Download,
  ExternalLink,
  FileText,
  Flashlight,
  GitPullRequest,
  GraduationCap,
  Hammer,
  HeartHandshake,
  RotateCcwClock,
  House,
  Layers,
  Lightbulb,
  Lock,
  Mail,
  MapPin,
  Moon,
  Newspaper,
  Package,
  RefreshCw,
  Rocket,
  ScanLine,
  ScrollText,
  ShieldCheck,
  Signal,
  Smartphone,
  Sparkles,
  Sun,
  SunMoon,
  Terminal,
  Timer,
  User,
  Wifi,
  Wrench,
} from '@lucide/astro';
import { siGithub, siMedium } from 'simple-icons';

const lucide = {
  'alarm-clock': AlarmClock,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  battery: BatteryFull,
  'bell-ring': BellRing,
  blocks: Blocks,
  'book-open': BookOpen,
  bot: Bot,
  brain: Brain,
  briefcase: Briefcase,
  camera: Camera,
  check: Check,
  'chevron-down': ChevronDown,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
  'circle-check': CircleCheck,
  play: CirclePlay,
  copy: Copy,
  cpu: Cpu,
  download: Download,
  external: ExternalLink,
  'file-text': FileText,
  flashlight: Flashlight,
  'git-pull-request': GitPullRequest,
  'graduation-cap': GraduationCap,
  hammer: Hammer,
  'heart-handshake': HeartHandshake,
  history: RotateCcwClock,
  house: House,
  layers: Layers,
  lightbulb: Lightbulb,
  lock: Lock,
  mail: Mail,
  'map-pin': MapPin,
  moon: Moon,
  newspaper: Newspaper,
  package: Package,
  'refresh-cw': RefreshCw,
  rocket: Rocket,
  'scan-line': ScanLine,
  'scroll-text': ScrollText,
  'shield-check': ShieldCheck,
  signal: Signal,
  smartphone: Smartphone,
  sparkles: Sparkles,
  sun: Sun,
  'sun-moon': SunMoon,
  terminal: Terminal,
  timer: Timer,
  user: User,
  wifi: Wifi,
  wrench: Wrench,
} as const;

// Brand marks (24×24, filled). GitHub & Medium come from Simple Icons (CC0).
const brands: Record<string, string> = {
  github: siGithub.path,
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  medium: siMedium.path,
};

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, label, strokeWidth = 2 } = Astro.props;
const LucideIcon = (lucide as Record<string, any>)[name];
const brandPath = brands[name];
const a11y = label ? ({ role: 'img', 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
---

{
  LucideIcon ? (
    <LucideIcon size={size} stroke-width={strokeWidth} class={className} {...a11y} />
  ) : brandPath ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      class={className}
      {...a11y}
    >
      <path d={brandPath} />
    </svg>
  ) : null
}
